# Environment variables for the Health Docket API (api/).
#
# Local development doesn't need any of these -- api/db.py and
# db/migrate.py default to db/health_docket.db in the repo checkout.
# This file documents what deploy/render.yaml sets in production.

# Overrides where the SQLite database file lives. Render points this at a
# path on its persistent disk (/var/data/health_docket.db) so the database
# survives restarts and redeploys. Leave unset for local development.
DATABASE_PATH=

# Guards POST /api/admin/refresh (Task 10) -- the endpoint GitHub Actions
# calls weekly to run the document-capture/extraction/tagging/briefing
# pipeline against the LIVE database. Generate a random value yourself
# (e.g. `openssl rand -hex 32`) and set the identical value here on
# Render AND as a GitHub Actions repo secret of the same name.
REFRESH_TOKEN=

# Needed on Render (not for local dev) so POST /api/admin/refresh can run
# pipeline/tag_subjects.py and pipeline/generate_briefings.py. Same key
# documented in the root .env.example.
ANTHROPIC_API_KEY=

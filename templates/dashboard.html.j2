<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Health Docket</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');

  :root{
    --paper: #f6f3ea; --paper-raised: #fffdf8; --ink: #1c2624; --ink-soft: #4c5854; --ink-faint: #7c8783;
    --line: #ddd5bf; --line-strong: #c7bd9f; --primary: #24544f; --primary-soft: #dde9e4;
    --accent: #b5651d; --accent-soft: #f3e2cc; --good: #3f7355; --good-soft: #dfeadf;
    --federal: #46587f; --federal-soft: #dfe4ee; --state: #24544f; --local: #b5651d; --today-ring: #b5651d;
    --shadow: 0 1px 2px rgba(28,38,36,0.06), 0 6px 16px rgba(28,38,36,0.05);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper: #121715; --paper-raised: #182420; --ink: #e9e6da; --ink-soft: #b7bcb2; --ink-faint: #7f8b85;
      --line: #2b3733; --line-strong: #3c4a44; --primary: #7bbead; --primary-soft: #1c322d;
      --accent: #e0973f; --accent-soft: #3a2c19; --good: #83c39a; --good-soft: #1c3025;
      --federal: #8ea3d1; --federal-soft: #212b3d; --state: #7bbead; --local: #e0973f; --today-ring: #e0973f;
      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 20px rgba(0,0,0,0.35);
    }
  }
  :root[data-theme="dark"]{
    --paper: #121715; --paper-raised: #182420; --ink: #e9e6da; --ink-soft: #b7bcb2; --ink-faint: #7f8b85;
    --line: #2b3733; --line-strong: #3c4a44; --primary: #7bbead; --primary-soft: #1c322d;
    --accent: #e0973f; --accent-soft: #3a2c19; --good: #83c39a; --good-soft: #1c3025;
    --federal: #8ea3d1; --federal-soft: #212b3d; --state: #7bbead; --local: #e0973f; --today-ring: #e0973f;
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 20px rgba(0,0,0,0.35);
  }
  *{ box-sizing: border-box; }
  html{ background: var(--paper); }
  body{ background: var(--paper); color: var(--ink); font-family: 'Public Sans', system-ui, sans-serif; line-height: 1.5; margin: 0; }
  .wrap{ max-width: 980px; margin: 0 auto; padding: 40px 24px 80px; }
  h1,h2,h3{ font-family: 'Source Serif 4', Georgia, serif; text-wrap: balance; margin: 0; }

  header.masthead{ border-bottom: 3px double var(--line-strong); padding-bottom: 18px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .masthead-title{ font-size: 2rem; font-weight: 700; color: var(--primary); letter-spacing: -0.01em; }
  .masthead-sub{ color: var(--ink-soft); font-size: 0.92rem; max-width: 46ch; margin-top: 4px; }
  .masthead-meta{ text-align: right; font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.6; }

  .tabs{ display: flex; gap: 4px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  .tab-btn{ font-family: 'Public Sans', sans-serif; font-size: 0.86rem; font-weight: 600; color: var(--ink-faint); background: none; border: none; border-bottom: 2px solid transparent; padding: 8px 4px 10px; margin-right: 22px; cursor: pointer; }
  .tab-btn:hover{ color: var(--ink); }
  .tab-btn.active{ color: var(--primary); border-bottom-color: var(--primary); }

  .cal-card{ background: var(--paper-raised); border: 1px solid var(--line); border-radius: 10px; padding: 20px 22px 22px; margin-bottom: 40px; box-shadow: var(--shadow); }
  .cal-head{ display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
  .cal-nav{ display: flex; align-items: center; gap: 10px; }
  .cal-nav button{ font-family: 'IBM Plex Mono', monospace; background: var(--paper); border: 1px solid var(--line-strong); color: var(--ink); width: 30px; height: 30px; border-radius: 6px; cursor: pointer; font-size: 0.95rem; line-height: 1; }
  .cal-nav button:hover{ border-color: var(--primary); color: var(--primary); }
  .cal-nav .cal-today-btn{ width: auto; padding: 0 10px; font-family: 'Public Sans', sans-serif; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .cal-month-label{ font-family: 'Source Serif 4', serif; font-size: 1.3rem; font-weight: 600; min-width: 168px; }
  .cal-legend{ display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.76rem; color: var(--ink-soft); }
  .cal-legend span{ display: inline-flex; align-items: center; gap: 6px; }
  .cal-legend i{ width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .dot-federal{ background: var(--federal); } .dot-state{ background: var(--state); } .dot-local{ background: var(--local); }
  .cal-grid{ display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  .cal-dow{ font-family: 'IBM Plex Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); text-align: center; padding-bottom: 4px; }
  .cal-cell{ position: relative; min-height: 58px; border: 1px solid var(--line); border-radius: 6px; padding: 5px 6px; background: var(--paper); }
  .cal-cell.pad{ background: transparent; border-color: transparent; }
  .cal-cell.has-events{ cursor: pointer; }
  .cal-cell.has-events:hover{ border-color: var(--primary); }
  .cal-cell.is-today{ box-shadow: inset 0 0 0 2px var(--today-ring); }
  .cal-cell.is-selected{ background: var(--primary-soft); border-color: var(--primary); }
  .cal-daynum{ font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; font-variant-numeric: tabular-nums; color: var(--ink-soft); }
  .cal-dots{ position: absolute; bottom: 6px; left: 6px; display: flex; gap: 3px; }
  .cal-dots i{ width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
  .cal-detail{ margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line); }
  .cal-detail-date{ font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); margin-bottom: 10px; }
  .cal-item{ margin-bottom: 12px; } .cal-item:last-child{ margin-bottom: 0; }
  .cal-item-head{ display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .cal-item-title{ font-weight: 600; font-size: 0.95rem; }
  .cal-item-note{ font-size: 0.84rem; color: var(--ink-soft); margin-top: 2px; }
  .cal-empty{ color: var(--ink-faint); font-size: 0.86rem; }

  section.tier{ margin-bottom: 40px; }
  .tier-head{ display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; }
  .tier-index{ font-family: 'IBM Plex Mono', monospace; color: var(--ink-faint); font-size: 0.78rem; }
  .tier-title{ font-size: 1.35rem; color: var(--ink); }
  .tier-desc{ color: var(--ink-soft); font-size: 0.85rem; margin: 4px 0 18px; max-width: 62ch; }

  .card{ background: var(--paper-raised); border: 1px solid var(--line); border-radius: 8px; padding: 18px 20px; margin-bottom: 14px; box-shadow: var(--shadow); }
  .card-head{ display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .card-name{ font-family: 'Source Serif 4', serif; font-weight: 600; font-size: 1.08rem; }
  .card-name a{ color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-strong); }
  .card-name a:hover{ color: var(--primary); border-color: var(--primary); }
  .pill{ font-family: 'IBM Plex Mono', monospace; font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; padding: 3px 9px; border-radius: 100px; white-space: nowrap; font-weight: 500; }
  .pill-upcoming{ background: var(--accent-soft); color: var(--accent); }
  .pill-recurring{ background: var(--primary-soft); color: var(--primary); }
  .pill-watch{ background: var(--line); color: var(--ink-soft); }
  .pill-federal{ background: var(--federal-soft); color: var(--federal); }
  .card-meta{ font-size: 0.82rem; color: var(--ink-soft); margin-top: 6px; }
  .linkrow{ display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .linkrow a{ font-size: 0.78rem; color: var(--ink); background: var(--paper); border: 1px solid var(--line); padding: 4px 10px; border-radius: 5px; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
  .linkrow a:hover{ border-color: var(--primary); color: var(--primary); }
  table.history{ width: 100%; border-collapse: collapse; font-size: 0.84rem; margin-top: 10px; }
  table.history th{ text-align: left; font-family: 'IBM Plex Mono', monospace; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); font-weight: 500; padding: 6px 10px 6px 0; border-bottom: 1px solid var(--line-strong); }
  table.history td{ padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  table.history td.date{ font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .table-wrap{ overflow-x: auto; }

  .briefing-intro{ color: var(--ink-soft); font-size: 0.88rem; max-width: 66ch; margin-bottom: 28px; }
  .briefing-intro b{ color: var(--ink); }
  .impact-card{ background: var(--paper-raised); border: 1px solid var(--line); border-radius: 8px; padding: 18px 20px; margin-bottom: 14px; box-shadow: var(--shadow); }
  .impact-date{ font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
  .impact-title{ font-family: 'Source Serif 4', serif; font-weight: 600; font-size: 1.05rem; }
  .impact-note{ margin-top: 12px; padding: 10px 14px; background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 5px 5px 0; font-size: 0.86rem; color: var(--ink); }
  .impact-note b{ display: block; font-family: 'IBM Plex Mono', monospace; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); margin-bottom: 4px; }
  .impact-note.unverified{ background: var(--line); border-left-color: var(--ink-faint); }
  .impact-note.unverified b{ color: var(--ink-soft); }
  .impact-empty{ color: var(--ink-faint); font-size: 0.86rem; }

  footer{ margin-top: 48px; padding-top: 20px; border-top: 3px double var(--line-strong); font-size: 0.78rem; color: var(--ink-faint); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 620px){ .masthead{ flex-direction: column; align-items: flex-start; } .masthead-meta{ text-align: left; } .cal-cell{ min-height: 44px; } .cal-daynum{ font-size: 0.64rem; } }
</style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div>
      <div class="masthead-title">Health Docket</div>
      <div class="masthead-sub">Health &amp; human services meetings across Congress, the Nevada Legislature, and Nevada's local health boards — agendas, minutes, and video in one place.</div>
    </div>
    <div class="masthead-meta">Built by scripts/render_site.py<br>Last refreshed {{ generated_at }}</div>
  </header>

  <nav class="tabs">
    <button class="tab-btn active" data-view="calendar">Calendar &amp; Directory</button>
    <button class="tab-btn" data-view="briefing">Impact Briefing</button>
  </nav>

  <div id="view-calendar" class="view">
    <div class="cal-card">
      <div class="cal-head">
        <div class="cal-nav">
          <button id="cal-prev" aria-label="Previous month">&lsaquo;</button>
          <div class="cal-month-label" id="cal-month-label"></div>
          <button id="cal-next" aria-label="Next month">&rsaquo;</button>
          <button class="cal-today-btn" id="cal-today">Today</button>
        </div>
        <div class="cal-legend">
          <span><i class="dot-federal"></i>Federal</span>
          <span><i class="dot-state"></i>NV Legislature</span>
          <span><i class="dot-local"></i>NV local boards</span>
        </div>
      </div>
      <div class="cal-grid" id="cal-dow"></div>
      <div class="cal-grid" id="cal-grid" style="margin-top:5px;"></div>
      <div class="cal-detail" id="cal-detail"></div>
    </div>

    {% for tier in tiers %}
    <section class="tier">
      <div class="tier-head">
        <span class="tier-index">{{ tier.index }}</span>
        <h2 class="tier-title">{{ tier.label }}</h2>
      </div>
      <p class="tier-desc">{{ tier.description }}</p>

      {% for source in tier.sources %}
      <div class="card">
        <div class="card-head">
          <span class="card-name"><a href="{{ source.watch_url }}" target="_blank" rel="noopener">{{ source.name }}</a></span>
          <span class="pill {{ tier_pill_class[tier.key] }}">{{ source.relevance_tags | join(', ') }}</span>
        </div>
        {% if source.meetings %}
        <div class="table-wrap">
          <table class="history">
            <tr><th>Date</th><th>Details</th></tr>
            {% for m in source.meetings[-8:] | reverse %}
            <tr>
              <td class="date">{{ m.date }}{% if m.time %} · {{ m.time }}{% endif %}</td>
              <td>
                {%- if m.note %}{{ m.note }}<br>{% endif -%}
                {% for l in m.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
                {%- if not m.verified %} <span class="pill pill-watch">unverified</span>{% endif -%}
              </td>
            </tr>
            {% endfor %}
          </table>
        </div>
        {% else %}
        <div class="card-meta">No meetings found yet by the scraper for this source — check it directly.</div>
        {% endif %}
        {% if source.watch_url %}
        <div class="linkrow"><a href="{{ source.watch_url }}" target="_blank" rel="noopener">Source page</a></div>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endfor %}
  </div>

  <div id="view-briefing" class="view" hidden>
    <p class="briefing-intro">Recent, completed meetings filtered for relevance to <b>NNPH's administrative functions</b> — finance/budget, HR/staffing, IT &amp; data systems, and grant/contract compliance — or to HHS policy broadly, written by Claude via <code>scripts/generate_briefing.py</code>. Items marked <span class="pill pill-watch" style="vertical-align:1px;">check source</span> mean the note is based on a title/topic only, not verified agenda or hearing content.</p>

    {% for tier in briefing_tiers %}
    <section class="tier">
      <div class="tier-head">
        <span class="tier-index">{{ tier.index }}</span>
        <h2 class="tier-title">{{ tier.label }}</h2>
      </div>
      {% if tier.entries %}
        {% for b in tier.entries %}
        <div class="impact-card">
          <div class="impact-date">{{ b.meeting.date }} · {{ b.meeting.title }}</div>
          {% if b.meeting.links %}<div class="impact-title"><a href="{{ b.meeting.links[0].url }}" target="_blank" rel="noopener">{{ b.meeting.note or b.meeting.title }}</a></div>
          {% else %}<div class="impact-title">{{ b.meeting.note or b.meeting.title }}</div>{% endif %}
          <div class="impact-note{% if b.confidence != 'verified' %} unverified{% endif %}">
            <b>{{ 'Why this matters to NNPH' if b.confidence == 'verified' else 'Check source' }}</b>
            {{ b.note }}
          </div>
        </div>
        {% endfor %}
      {% else %}
        <p class="impact-empty">No briefing items yet for this tier.</p>
      {% endif %}
    </section>
    {% endfor %}
  </div>

  <footer>
    <span>Sources are public government portals — Congress.gov, NELIS, Legistar, and each health district's own site. Calendar dots mark confirmed dates only.</span>
    <span>Rebuilt weekly by GitHub Actions.</span>
  </footer>

</div>

<script>
(function(){
  var MEETINGS = {{ calendar_meetings_json | safe }};

  var DOW = ['Su','Mo','Tu','We','Th','Fr','Sa'];
  var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

  function iso(y,m,d){ var mm=String(m+1).padStart(2,'0'); var dd=String(d).padStart(2,'0'); return y+'-'+mm+'-'+dd; }
  function byDate(dateStr){ return MEETINGS.filter(function(m){ return m.date === dateStr; }); }

  var today = new Date(); today.setHours(0,0,0,0);
  var todayIso = iso(today.getFullYear(), today.getMonth(), today.getDate());

  var sorted = MEETINGS.slice().sort(function(a,b){ return a.date.localeCompare(b.date); });
  var upcoming = sorted.filter(function(m){ return m.date >= todayIso; });
  var defaultSelected = upcoming.length ? upcoming[0].date : (sorted.length ? sorted[sorted.length-1].date : todayIso);
  var defParts = defaultSelected.split('-').map(Number);
  var viewYear = defParts[0], viewMonth = defParts[1]-1, selected = defaultSelected;

  var dowEl = document.getElementById('cal-dow');
  DOW.forEach(function(d){ var el=document.createElement('div'); el.className='cal-dow'; el.textContent=d; dowEl.appendChild(el); });

  var gridEl = document.getElementById('cal-grid');
  var labelEl = document.getElementById('cal-month-label');
  var detailEl = document.getElementById('cal-detail');

  function renderDetail(dateStr){
    var items = byDate(dateStr);
    var d = new Date(dateStr+'T00:00:00');
    var heading = d.toLocaleDateString(undefined, {weekday:'long', month:'long', day:'numeric', year:'numeric'});
    var html = '<div class="cal-detail-date">'+heading+'</div>';
    if(!items.length){ html += '<div class="cal-empty">No tracked meetings on this date.</div>'; }
    else {
      items.forEach(function(it){
        var pillClass = it.tier === 'federal' ? 'pill-federal' : (it.tier === 'state' ? 'pill-recurring' : 'pill-upcoming');
        var tierLabel = it.tier === 'federal' ? 'Federal' : (it.tier === 'state' ? 'NV Legislature' : 'NV local');
        html += '<div class="cal-item"><div class="cal-item-head"><span class="pill '+pillClass+'">'+tierLabel+'</span><span class="cal-item-title">'+it.title+'</span></div>';
        if(it.note){ html += '<div class="cal-item-note">'+it.note+'</div>'; }
        if(it.links && it.links.length){
          html += '<div class="linkrow">';
          it.links.forEach(function(l){ html += '<a href="'+l.url+'" target="_blank" rel="noopener">'+l.label+'</a>'; });
          html += '</div>';
        }
        html += '</div>';
      });
    }
    detailEl.innerHTML = html;
  }

  function renderGrid(){
    labelEl.textContent = MONTHS[viewMonth] + ' ' + viewYear;
    gridEl.innerHTML = '';
    var firstDow = new Date(viewYear, viewMonth, 1).getDay();
    var daysInMonth = new Date(viewYear, viewMonth+1, 0).getDate();
    for(var i=0;i<firstDow;i++){ var pad=document.createElement('div'); pad.className='cal-cell pad'; gridEl.appendChild(pad); }
    for(var day=1; day<=daysInMonth; day++){
      var dateStr = iso(viewYear, viewMonth, day);
      var items = byDate(dateStr);
      var cell = document.createElement('div');
      cell.className = 'cal-cell' + (items.length ? ' has-events' : '') + (dateStr === todayIso ? ' is-today' : '') + (dateStr === selected ? ' is-selected' : '');
      cell.setAttribute('data-date', dateStr);
      var num = document.createElement('div'); num.className='cal-daynum'; num.textContent=day; cell.appendChild(num);
      if(items.length){
        var dots = document.createElement('div'); dots.className='cal-dots';
        var seenTiers = [];
        items.forEach(function(it){ if(seenTiers.indexOf(it.tier)===-1){ seenTiers.push(it.tier); } });
        seenTiers.forEach(function(t){ var dot=document.createElement('i'); dot.className='dot-'+t; dots.appendChild(dot); });
        cell.appendChild(dots);
        cell.addEventListener('click', function(){ var ds=this.getAttribute('data-date'); selected=ds; renderGrid(); renderDetail(ds); });
      }
      gridEl.appendChild(cell);
    }
    renderDetail(selected);
  }

  document.getElementById('cal-prev').addEventListener('click', function(){ viewMonth-=1; if(viewMonth<0){viewMonth=11;viewYear-=1;} renderGrid(); });
  document.getElementById('cal-next').addEventListener('click', function(){ viewMonth+=1; if(viewMonth>11){viewMonth=0;viewYear+=1;} renderGrid(); });
  document.getElementById('cal-today').addEventListener('click', function(){ viewYear=today.getFullYear(); viewMonth=today.getMonth(); selected=todayIso; renderGrid(); });

  renderGrid();

  var tabBtns = document.querySelectorAll('.tab-btn');
  var views = { calendar: document.getElementById('view-calendar'), briefing: document.getElementById('view-briefing') };
  tabBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = this.getAttribute('data-view');
      tabBtns.forEach(function(b){ b.classList.remove('active'); });
      this.classList.add('active');
      Object.keys(views).forEach(function(k){ views[k].hidden = (k !== target); });
    });
  });
})();
</script>
</body>
</html>
